# Serves the site on both HTTP (80) and HTTPS (443) for the server's public IP. No redirect.
# Used when the certificate is a Let's Encrypt IP-address certificate (cert name __CERT_NAME__).
# Rendered by deploy/frontend-deploy.sh into /etc/nginx/conf.d/vpc-demo.conf.
# Placeholders: __CERT_NAME__ and BACKEND_PRIVATE_IP.

server {
    listen 80;
    server_name _;

    root /var/www/vpc-demo/dist;
    index index.html;

    location / {
        try_files $uri /index.html;
    }

    location /api/ {
        proxy_pass http://BACKEND_PRIVATE_IP:3001/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/letsencrypt/live/__CERT_NAME__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__CERT_NAME__/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    root /var/www/vpc-demo/dist;
    index index.html;

    location / {
        try_files $uri /index.html;
    }

    location /api/ {
        proxy_pass http://BACKEND_PRIVATE_IP:3001/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
}
